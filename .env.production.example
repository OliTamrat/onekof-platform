# Onekof Platform — Production Environment Variables
# ====================================================
# Copy this file to .env.production and fill in every value.
# NEVER commit .env.production to git.
#
# Generate NEXTAUTH_SECRET with:  openssl rand -base64 32
# Generate POSTGRES_PASSWORD with: openssl rand -hex 24
# Generate REDIS_PASSWORD with:    openssl rand -hex 24

# --------------------------------------------------------------------------
# DOCKER IMAGE
# --------------------------------------------------------------------------
# Which image to pull. Set to a specific version tag for production stability.
# Example: ghcr.io/daps-analytics/onekof-web:v1.0.0
DOCKER_IMAGE=ghcr.io/daps-analytics/onekof-web:latest

# --------------------------------------------------------------------------
# DATABASE (PostgreSQL 15)
# --------------------------------------------------------------------------
POSTGRES_USER=onekof
POSTGRES_PASSWORD=CHANGE_ME_USE_openssl_rand_hex_24
POSTGRES_DB=onekof

# ---- SUPABASE (cloud / Tier 3) ----
# Transaction Pooler — port 6543, IPv4, used by the app at runtime.
# Append pgbouncer=true&connection_limit=1 (required for Prisma + PgBouncer).
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Session Pooler — port 5432, IPv4, used by Prisma migrate for DDL migrations.
# Free tier direct connection (db.xxx.supabase.co) is IPv6-only and won't work
# from GitHub Actions or IPv4 servers. Use Session Pooler here instead.
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ---- SELF-HOSTED (Tier 2 — docker-compose.prod.yml) ----
# Both point to the local postgres container — no pooler needed.
DATABASE_URL=postgresql://onekof:CHANGE_ME@postgres:5432/onekof?schema=public
DIRECT_URL=postgresql://onekof:CHANGE_ME@postgres:5432/onekof?schema=public

# --------------------------------------------------------------------------
# REDIS
# --------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_USE_openssl_rand_hex_24
REDIS_URL=redis://:CHANGE_ME@redis:6379

# --------------------------------------------------------------------------
# NEXTAUTH
# --------------------------------------------------------------------------
NEXTAUTH_SECRET=CHANGE_ME_USE_openssl_rand_base64_32
NEXTAUTH_URL=https://onekof.et
AUTH_COOKIE_DOMAIN=.onekof.et

# --------------------------------------------------------------------------
# APP IDENTITY
# --------------------------------------------------------------------------
NODE_ENV=production
APP_ENV=production
APP_PLATFORM=self-hosted
APP_REGION=et-addis-1
NEXT_PUBLIC_APP_URL=https://onekof.et
NEXT_PUBLIC_APP_NAME=Onekof
PUBLIC_HOSTS=onekof.et
NEXT_PUBLIC_SUBDOMAIN_DOMAINS=onekof.et

# --------------------------------------------------------------------------
# FILE STORAGE (local filesystem — Wave 1 driver)
# --------------------------------------------------------------------------
STORAGE_DRIVER=local-fs
STORAGE_LOCAL_ROOT=/var/onekof/blobs
STORAGE_LOCAL_BASE_URL=https://onekof.et/api/files
# INSA P4: AES-256-GCM at-rest encryption for all uploaded files (required in production)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BLOB_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_32_BYTES

# --------------------------------------------------------------------------
# FEATURE FLAGS
# --------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_AI_FEATURES=false
NEXT_PUBLIC_ENABLE_ETHIOPIAN_CALENDAR=true
ENABLE_EMAIL_VERIFICATION=true

# OAuth provider visibility — controls which sign-in buttons appear on the login page
# Set to 'true' only AFTER credentials + redirect URIs are configured in each provider's console
# Required redirect URIs:
#   Google:    https://onekof.com/api/auth/callback/google
#   Microsoft: https://onekof.com/api/auth/callback/azure-ad
#   GitHub:    https://onekof.com/api/auth/callback/github
#   LinkedIn:  https://onekof.com/api/auth/callback/linkedin
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=false
NEXT_PUBLIC_ENABLE_MICROSOFT_OAUTH=false
NEXT_PUBLIC_ENABLE_GITHUB_OAUTH=false
NEXT_PUBLIC_ENABLE_LINKEDIN_OAUTH=false

# --------------------------------------------------------------------------
# EMAIL (Resend)
# --------------------------------------------------------------------------
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=noreply@onekof.et

# --------------------------------------------------------------------------
# ERROR TRACKING (Sentry)
# --------------------------------------------------------------------------
# SENTRY_DSN is used by sentry.server.config.ts (server-side, not public)
SENTRY_DSN=CHANGE_ME
# NEXT_PUBLIC_SENTRY_DSN is used by sentry.client.config.ts + sentry.edge.config.ts
# Must be the same DSN value — both vars are required for full coverage
NEXT_PUBLIC_SENTRY_DSN=CHANGE_ME
SENTRY_ORG=CHANGE_ME
SENTRY_PROJECT=onekof-platform

# --------------------------------------------------------------------------
# LOGGING
# --------------------------------------------------------------------------
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# --------------------------------------------------------------------------
# OPTIONAL — AI FEATURES (enable when Anthropic key is provisioned)
# --------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# --------------------------------------------------------------------------
# ADMIN PANEL (required for /admin routes)
# --------------------------------------------------------------------------
# Generate ADMIN_SECRET with: openssl rand -hex 32
ADMIN_SECRET=CHANGE_ME_USE_openssl_rand_hex_32
# Comma-separated list of username:bcrypt-hash pairs
# Generate hash: node -e "const b=require('bcryptjs');b.hash('yourpass',12).then(h=>console.log('admin:'+h))"
ADMIN_USERS=admin:CHANGE_ME_BCRYPT_HASH

# --------------------------------------------------------------------------
# CRON JOBS (required for /api/admin/cleanup and analytics aggregate)
# --------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
CRON_SECRET=CHANGE_ME_USE_openssl_rand_hex_32

# --------------------------------------------------------------------------
# FIELD-LEVEL ENCRYPTION (optional — for future PII encryption)
# --------------------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FIELD_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_32_BYTES

# --------------------------------------------------------------------------
# OPTIONAL — GOOGLE OAUTH
# --------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=CHANGE_ME
# GOOGLE_CLIENT_SECRET=CHANGE_ME
