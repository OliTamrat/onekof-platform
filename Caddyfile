# Onekof Platform — Caddy reverse proxy config
# Handles SSL termination and security headers for Tier 2 / Tier 3 self-hosted
#
# Caddy automatically provisions Let's Encrypt certificates.
# Tenant subdomains use on_demand TLS — certs are issued per-subdomain
# via HTTP-01 challenge as tenants are created. No DNS provider needed.

# Shared security headers snippet
(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        -Server
        -X-Powered-By
    }
}

# Shared logging snippet
(access_log) {
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 7
        }
        format json
    }
}

# On-demand TLS config — Caddy asks the app to verify valid subdomains
# before issuing a certificate, preventing abuse.
{
    on_demand_tls {
        ask http://onekof-web:3000/api/health
    }
}

# ---------------------------------------------------------------------------
# Apex domain — onekof.et
# ---------------------------------------------------------------------------
onekof.et {
    reverse_proxy onekof-web:3000
    import security_headers
    encode gzip
    import access_log
}

# ---------------------------------------------------------------------------
# Wildcard — *.onekof.et (multi-tenant subdomains)
# Each organization gets its own subdomain (e.g. ministry.onekof.et).
# The Next.js app reads the Host header to resolve the tenant.
# On-demand TLS issues individual certs per subdomain via HTTP-01.
# ---------------------------------------------------------------------------
*.onekof.et {
    tls {
        on_demand
    }
    reverse_proxy onekof-web:3000
    import security_headers
    encode gzip
    import access_log
}

# Redirect www to apex domain
www.onekof.et {
    redir https://onekof.et{uri} permanent
}
