# Onekof Platform — Tier 3 (Vercel + Supabase, Global Cloud) Environment Reference
# =================================================================================
#
# Tier 3 target: international customers, demos, trials on Vercel + Supabase
# (EU-hosted, current production deployment). This is the reference for what
# onekof.com runs in production today. Most values are already set in the
# Vercel dashboard under "Environment Variables" — this file exists as
# documentation, NOT as a template to copy to local disk.
#
# Wave 1 notes:
# - All new Wave 1 env vars (AUTH_COOKIE_DOMAIN, PUBLIC_HOSTS, STORAGE_DRIVER,
#   etc.) default to the pre-Wave-1 Tier 3 behavior when unset. Tier 3 works
#   without setting any of the new vars explicitly.
# - The entries below show the EXPLICIT values you'd set if you wanted to
#   override defaults, or if you were configuring a fresh Vercel project
#   from scratch.
#
# Related files:
#   .env.tier2.example — Tier 2 private on-premise template
#   apps/web/.env.example — legacy dev template

# ============================================================================
# DEPLOYMENT IDENTITY
# ============================================================================

# Vercel auto-populates these — do NOT set them manually.
# APP_PLATFORM is detected from VERCEL=1 at runtime.
# APP_REGION is read from VERCEL_REGION (e.g., "fra1").
# APP_ENV is read from VERCEL_ENV (production | preview | development).
# APP_BUILD_SHA is read from VERCEL_DEPLOYMENT_ID (truncated to 8 chars).

# ============================================================================
# DATABASE — Supabase PostgreSQL 15 (aws-1-eu-central-1)
# ============================================================================

# Supabase connection URL through pgbouncer (transaction mode).
# The pgbouncer=true and connection_limit=1 parameters are CRITICAL for
# Vercel serverless — without them, Prisma runs out of connections.
# See PROJECT_GUIDELINES.md § Database / Migration Rules.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) for migrations and admin tasks.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# ============================================================================
# NEXTAUTH
# ============================================================================

# Unique secret for Tier 3. Never share with other tiers.
NEXTAUTH_SECRET="REDACTED_set_in_vercel_dashboard"

# Production URL
NEXTAUTH_URL="https://onekof.com"

# Wave 1: cookie domain can be left unset on Tier 3 — it defaults to
# `.onekof.com` for production builds and `undefined` on Vercel preview
# deployments (per auth.ts resolveAuthCookieDomain()).
# AUTH_COOKIE_DOMAIN=".onekof.com"

# ============================================================================
# MULTI-TENANT ROUTING — Wave 1
# ============================================================================

# Defaults preserve pre-Wave-1 behavior, so these can be left unset on Tier 3.
# PUBLIC_HOSTS="onekof.com,localhost,vercel.app"
# NEXT_PUBLIC_SUBDOMAIN_DOMAINS="onekof.com"

NEXT_PUBLIC_APP_URL="https://onekof.com"
NEXT_PUBLIC_APP_NAME="Onekof"

# ============================================================================
# FILE STORAGE — Vercel Blob (default on Tier 3)
# ============================================================================

# STORAGE_DRIVER defaults to "vercel-blob" when unset.
# STORAGE_DRIVER="vercel-blob"

# Vercel Blob read/write token — auto-injected by the Vercel Blob integration
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_REDACTED"

# ============================================================================
# REDIS — Upstash (optional, used for rate limiting)
# ============================================================================

# Without these, rate limiting falls back to in-memory (broken under serverless
# multi-instance scaling). Set up a free Upstash project to enable.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# Anthropic API for AI document processing
ANTHROPIC_API_KEY=""

# Resend for transactional email
RESEND_API_KEY=""
EMAIL_FROM="noreply@onekof.com"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================================================
# OBSERVABILITY — Sentry
# ============================================================================

SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT="onekof-platform"
SENTRY_AUTH_TOKEN=""  # only used at build time for source-map upload

# ============================================================================
# FEATURE FLAGS
# ============================================================================

NODE_ENV="production"
NEXT_PUBLIC_ENABLE_AI_FEATURES="true"
NEXT_PUBLIC_ENABLE_ETHIOPIAN_CALENDAR="true"

# ============================================================================
# ADMIN PANEL — /admin routes (Wave 2)
# ============================================================================

# Secret key for signing admin JWT tokens. Generate with: openssl rand -base64 32
ADMIN_SECRET="REDACTED_set_in_vercel_dashboard"

# JSON array of admin users. Passwords MUST be bcrypt hashes (12 rounds).
# Generate a hash: node -e "require('bcryptjs').hash('yourpassword',12).then(h=>console.log(h))"
# ADMIN_USERS='[{"username":"admin","password":"$2a$12$...bcrypt_hash...","role":"OWNER","name":"Oli Tamrat"}]'
ADMIN_USERS=""

# ============================================================================
# VERCEL-SPECIFIC
# ============================================================================

# vercel.json pins the region to fra1 (Frankfurt) to colocate with Supabase eu-central-1.
# This file does not override that.
