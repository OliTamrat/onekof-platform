# Onekof Platform — Tier 2 (Private / On-Premise Ethiopia) Environment Template
# ==============================================================================
#
# Tier 2 target: private-sector Ethiopian customers on self-hosted hardware
# (e.g., on-premise server or small datacenter in Addis Ababa). This file
# documents every environment variable needed to run Onekof on a Linux host
# with PostgreSQL, Redis, and local filesystem storage.
#
# Copy this file to `.env` on your Tier 2 deployment and fill in real values.
# NEVER commit the resulting `.env` file to git.
#
# For docker-compose local simulation, copy this to `.env` in the repo root
# and run `docker compose -f docker-compose.tier-sim.yml up -d`.
#
# Related files:
#   .env.tier3.example — Vercel + Supabase (current production reference)
#   apps/web/.env.example — legacy dev template
#   apps/web/src/lib/env/runtime.ts — how the app reads these vars
#   apps/web/src/lib/storage/index.ts — storage driver factory
#   apps/web/src/middleware.ts — PUBLIC_HOSTS parser

# ============================================================================
# DEPLOYMENT IDENTITY — tells the runtime abstraction what tier this is
# ============================================================================

# Logical environment: production | staging | development
APP_ENV="production"

# Tag the app as self-hosted (not Vercel)
APP_PLATFORM="self-hosted"

# Geographic region identifier — shows up in /api/admin/health
# Examples: "addis-ababa-1", "dire-dawa-1", "home-lab-1"
APP_REGION="addis-ababa-1"

# Short build identifier — set this from CI or `git rev-parse --short HEAD`
APP_BUILD_SHA="local-dev"

# ============================================================================
# DATABASE — self-hosted PostgreSQL (NOT Supabase)
# ============================================================================

# PostgreSQL connection string.
# CRITICAL: Do NOT include `pgbouncer=true&connection_limit=1` here — those
# parameters are Supabase-specific and break bare PostgreSQL. Tier 2 runs
# PostgreSQL natively (or behind a self-hosted pgbouncer on localhost:6432).
#
# Docker-compose default: postgres://onekof:onekof@postgres:5432/onekof
DATABASE_URL="postgresql://onekof:onekof@postgres:5432/onekof?schema=public"

# Direct connection URL (for `prisma migrate deploy` and admin tools).
# For Tier 2 this is usually the same as DATABASE_URL.
DIRECT_URL="postgresql://onekof:onekof@postgres:5432/onekof?schema=public"

# ============================================================================
# NEXTAUTH — session + auth configuration
# ============================================================================

# Session signing secret. Generate with: openssl rand -base64 32
# MUST be different from Tier 3 — never reuse across tiers.
NEXTAUTH_SECRET="REPLACE_ME_WITH_openssl_rand_base64_32"

# Public URL the app is served from. Must match the actual hostname
# users visit, including scheme and port.
NEXTAUTH_URL="https://onekof.et"

# Cookie domain for cross-subdomain sessions.
# Tier 2 pattern: `.onekof.et` so `acme.onekof.et` and `ministry.onekof.et`
# share the same session cookie.
# Leading dot is required for subdomain sharing.
AUTH_COOKIE_DOMAIN=".onekof.et"

# ============================================================================
# MULTI-TENANT ROUTING — Wave 1 Portability
# ============================================================================

# Comma-separated list of base hostnames from which to extract tenant slugs.
# Middleware recognizes `{slug}.{base}` as a tenant URL for any listed base.
# Default for docker-compose local simulation: add "localhost" for convenience.
PUBLIC_HOSTS="onekof.et,localhost"

# Client-side equivalent — visible in the browser bundle, controls the
# redirect logic in select-organization/page.tsx and auth flows.
NEXT_PUBLIC_SUBDOMAIN_DOMAINS="onekof.et"

# Public app URL shown in marketing copy and sent in emails
NEXT_PUBLIC_APP_URL="https://onekof.et"
NEXT_PUBLIC_APP_NAME="Onekof"

# ============================================================================
# FILE STORAGE — Wave 1 local-fs driver
# ============================================================================

# Select the storage driver. Tier 2 uses local filesystem storage.
# Options: vercel-blob | local-fs | s3
STORAGE_DRIVER="local-fs"

# Filesystem directory where uploaded files are written.
# MUST be persistent (mounted volume in Docker, real directory on bare metal).
# The running process needs read+write permissions on this directory.
STORAGE_LOCAL_ROOT="/var/onekof/blobs"

# Public base URL that serves files back to users. Routed by the
# /api/files/[...path]/route.ts handler which enforces org membership.
# Must match NEXTAUTH_URL or be a subpath of it.
STORAGE_LOCAL_BASE_URL="https://onekof.et/api/files"

# ============================================================================
# REDIS — rate limiting + (future) caching
# ============================================================================

# Standard Redis connection URL. Tier 2 runs Redis on the same host
# (or alongside in docker-compose) rather than using Upstash.
REDIS_URL="redis://redis:6379"

# ============================================================================
# EXTERNAL SERVICES — kept remote for Tier 2 (stays in production)
# ============================================================================

# Anthropic API key for AI document processing. Leave blank to disable AI.
ANTHROPIC_API_KEY=""

# Resend API key for transactional email. Leave blank to disable email.
RESEND_API_KEY=""
EMAIL_FROM="noreply@onekof.et"

# Google OAuth — optional. Must register a new client with the Tier 2
# callback URL (https://onekof.et/api/auth/callback/google) before enabling.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================================================
# OBSERVABILITY — Sentry still optional for Tier 2
# ============================================================================

# Sentry DSN. Leave blank to disable error reporting.
# For government/compliance-sensitive deployments, consider self-hosted
# Sentry or GlitchTip so crash data does not leave Ethiopia.
SENTRY_DSN=""

# Logging level: error | warn | info | http | debug
LOG_LEVEL="info"
LOG_RETENTION_DAYS="14"

# ============================================================================
# FEATURE FLAGS
# ============================================================================

NODE_ENV="production"
NEXT_PUBLIC_ENABLE_AI_FEATURES="true"
NEXT_PUBLIC_ENABLE_ETHIOPIAN_CALENDAR="true"
ENABLE_GOOGLE_OAUTH="false"
ENABLE_EMAIL_VERIFICATION="true"

# ============================================================================
# TIER 2 DEPLOYMENT CHECKLIST
# ============================================================================
#
# Before starting the app:
#   [ ] DATABASE_URL points at a running PostgreSQL 15 instance with the
#       Onekof schema applied (run all migrations from packages/database/prisma/migrations/)
#   [ ] NEXTAUTH_SECRET is a unique random value (not shared with other tiers)
#   [ ] NEXTAUTH_URL matches the public URL users type in their browser
#   [ ] AUTH_COOKIE_DOMAIN starts with a dot (.onekof.et, not onekof.et)
#   [ ] PUBLIC_HOSTS contains every domain that should route tenant subdomains
#   [ ] STORAGE_LOCAL_ROOT exists and is writable by the app process
#   [ ] STORAGE_LOCAL_BASE_URL matches NEXTAUTH_URL
#   [ ] Redis is reachable at REDIS_URL
#   [ ] Reverse proxy (Caddy/Nginx) terminates TLS and forwards to the app
#   [ ] DNS wildcard: `*.onekof.et` points at the Tier 2 server IP
#   [ ] Daily backups of PostgreSQL and /var/onekof/blobs are scheduled
