# OnekOf Platform - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================================================
# DATABASE
# ============================================================================

# PostgreSQL Database URL (required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example: postgresql://postgres:password@localhost:5432/onekof
DATABASE_URL="postgresql://user:password@host:port/database"

# ============================================================================
# NEXTAUTH CONFIGURATION
# ============================================================================

# NextAuth Secret (required)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"

# NextAuth URL (required)
# Development: http://localhost:3000
# Production: https://onekof.com
NEXTAUTH_URL="http://localhost:3000"

# ============================================================================
# GOOGLE OAUTH (Optional - for Google Sign-In)
# ============================================================================

# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================================================
# REDIS / UPSTASH (Optional - for production rate limiting)
# ============================================================================

# Get free account at: https://upstash.com
# Note: Rate limiting works without Redis (uses in-memory fallback)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ============================================================================
# SENTRY (Optional - for error tracking)
# ============================================================================

# Get account at: https://sentry.io
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_ORG="your-organization"
SENTRY_PROJECT="onekof-platform"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# ============================================================================
# EMAIL SERVICE (Required for production)
# ============================================================================

# Option 1: Resend (Recommended)
# Get API key at: https://resend.com
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="noreply@onekof.com"

# Option 2: SendGrid
# SENDGRID_API_KEY="SG.your_api_key"

# Option 3: Amazon SES
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="us-east-1"

# ============================================================================
# FILE STORAGE (Optional)
# ============================================================================

# Option 1: AWS S3
# AWS_S3_BUCKET="your-bucket-name"
# AWS_S3_REGION="us-east-1"
# AWS_S3_ACCESS_KEY_ID="your-access-key"
# AWS_S3_SECRET_ACCESS_KEY="your-secret-key"

# Option 2: Cloudflare R2
# CLOUDFLARE_R2_ACCOUNT_ID="your-account-id"
# CLOUDFLARE_R2_ACCESS_KEY_ID="your-access-key"
# CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-secret-key"
# CLOUDFLARE_R2_BUCKET="your-bucket-name"

# Option 3: Vercel Blob (Recommended for Vercel deployments)
# BLOB_READ_WRITE_TOKEN="vercel_blob_token"

# ============================================================================
# ANALYTICS (Optional)
# ============================================================================

# Google Analytics
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Vercel Analytics (automatic on Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID="auto"

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Environment
NODE_ENV="development" # development | production | test

# Enable/disable features
ENABLE_GOOGLE_OAUTH="true"
ENABLE_EMAIL_VERIFICATION="true"
ENABLE_2FA="false" # Not yet implemented

# ============================================================================
# DOMAIN CONFIGURATION
# ============================================================================

# Vercel deployment URL (auto-populated by Vercel)
# VERCEL_URL="your-app.vercel.app"

# Custom domain
# NEXT_PUBLIC_DOMAIN="onekof.com"

# ============================================================================
# RATE LIMITING CONFIGURATION (Optional overrides)
# ============================================================================

# Override default rate limits (optional)
# RATE_LIMIT_LOGIN_ATTEMPTS="3"
# RATE_LIMIT_LOGIN_WINDOW_MINUTES="15"
# RATE_LIMIT_PASSWORD_RESET_ATTEMPTS="3"
# RATE_LIMIT_PASSWORD_RESET_WINDOW_MINUTES="60"
# RATE_LIMIT_SIGNUP_ATTEMPTS="3"
# RATE_LIMIT_SIGNUP_WINDOW_MINUTES="60"

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Account lockout settings (optional overrides)
# ACCOUNT_LOCKOUT_MAX_ATTEMPTS="5"
# ACCOUNT_LOCKOUT_WINDOW_MINUTES="30"

# Password requirements (optional overrides)
# PASSWORD_MIN_LENGTH="8"
# PASSWORD_REQUIRE_UPPERCASE="true"
# PASSWORD_REQUIRE_LOWERCASE="true"
# PASSWORD_REQUIRE_NUMBER="true"
# PASSWORD_REQUIRE_SPECIAL="false"

# ============================================================================
# LOGGING
# ============================================================================

# Log level: error | warn | info | http | debug
LOG_LEVEL="info"

# Log retention (days)
LOG_RETENTION_DAYS="14"

# ============================================================================
# NOTES
# ============================================================================

# Required for Development:
# - DATABASE_URL
# - NEXTAUTH_SECRET
# - NEXTAUTH_URL

# Required for Production:
# - DATABASE_URL
# - NEXTAUTH_SECRET
# - NEXTAUTH_URL
# - RESEND_API_KEY or other email service
# - UPSTASH_REDIS_REST_URL (recommended)
# - SENTRY_DSN (recommended)

# Optional but Recommended:
# - GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET (for Google OAuth)
# - File storage service (S3, R2, or Vercel Blob)
# - Analytics (Google Analytics or Vercel Analytics)
