// Onekof Platform Database Schema
// Multi-tenant architecture with schema-based isolation

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
  schemas    = ["public"]
}

// ============================================================================
// PUBLIC SCHEMA - Shared across all tenants
// ============================================================================

// Organizations (tenants)
model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  schemaName String   @unique @map("schema_name") // e.g., "onekof_org_abc123"

  // Subscription & billing
  plan             Plan         @default(FREE)
  status           OrgStatus    @default(TRIAL)
  billingEmail     String?      @map("billing_email")
  subscriptionId   String?      @map("subscription_id")
  trialEndsAt      DateTime?    @map("trial_ends_at")
  currentPeriodEnd DateTime?    @map("current_period_end")

  // Limits (based on plan)
  maxMembers   Int @default(10) @map("max_members")
  maxProjects  Int @default(10) @map("max_projects")
  maxStorage   Int @default(5)  @map("max_storage") // GB

  // Settings
  settings Json @default("{}")
  features Json @default("[]")

  // Ethiopian-specific
  preferredCalendar Calendar @default(GREGORIAN) @map("preferred_calendar")
  primaryLanguage   Language @default(EN) @map("primary_language")

  // Metadata
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  members     OrganizationMember[]
  invitations Invitation[]
  projects    Project[]

  @@map("organizations")
  @@schema("public")
}

// Users (global, shared across organizations)
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")

  // Profile
  name        String?
  avatar      String?
  bio         String?
  phone       String?
  timezone    String   @default("Africa/Addis_Ababa")
  language    Language @default(EN)

  // Authentication
  password         String?   // Hashed with bcrypt
  resetToken       String?   // Password reset token
  resetTokenExpiry DateTime? @map("reset_token_expiry") // Reset token expiration

  // Preferences
  preferences Json @default("{}") // UI preferences, notifications, etc.

  // Default organization (for quick access)
  defaultOrganizationId String? @map("default_organization_id")

  // Metadata
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  accounts      Account[]
  sessions      Session[]
  organizations OrganizationMember[]

  @@map("users")
  @@schema("public")
}

// Organization membership
model OrganizationMember {
  id String @id @default(cuid())

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role OrgRole @default(MEMBER)

  // Metadata
  joinedAt  DateTime @default(now()) @map("joined_at")
  invitedBy String?  @map("invited_by")

  @@unique([organizationId, userId])
  @@map("organization_members")
  @@schema("public")
}

// Invitations
model Invitation {
  id String @id @default(cuid())

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email      String
  role       OrgRole
  token      String   @unique
  invitedBy  String   @map("invited_by")
  expiresAt  DateTime @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("invitations")
  @@schema("public")
}

// OAuth accounts (Google, Microsoft, etc.)
model Account {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String @map("provider_account_id")

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
  @@schema("public")
}

// Sessions (for NextAuth.js)
model Session {
  id String @id @default(cuid())

  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("public")
}

// Verification tokens (email verification, password reset)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
  @@schema("public")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE

  @@schema("public")
}

enum OrgStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED

  @@schema("public")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  GUEST

  @@schema("public")
}

enum Language {
  EN // English
  AM // Amharic (አማርኛ)
  OM // Afaan Oromo
  TI // Tigrinya (ትግርኛ)
  SO // Somali

  @@schema("public")
}

enum Calendar {
  GREGORIAN
  ETHIOPIAN

  @@schema("public")
}

// ============================================================================
// PROJECT MANAGEMENT MODELS
// ============================================================================

// Projects within an organization
model Project {
  id String @id @default(cuid())

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Project details
  name        String
  key         String // Project key (e.g., "ONEKOF", "PROJ")
  description String?
  icon        String? // Emoji or icon identifier
  color       String? // Hex color

  // Settings
  defaultAssignee String? @map("default_assignee")
  leadId          String? @map("lead_id")

  // Project type and status
  template    ProjectTemplate @default(KANBAN)
  isArchived  Boolean         @default(false) @map("is_archived")
  isFavorite  Boolean         @default(false) @map("is_favorite")

  // Metadata
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String    @map("created_by")

  // Relations
  tasks   Task[]
  members ProjectMember[]

  @@unique([organizationId, key])
  @@map("projects")
  @@schema("public")
}

// Project members (separate from org members for project-specific roles)
model ProjectMember {
  id String @id @default(cuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  role   ProjectRole @default(MEMBER)

  addedAt DateTime @default(now()) @map("added_at")
  addedBy String   @map("added_by")

  @@unique([projectId, userId])
  @@map("project_members")
  @@schema("public")
}

// Tasks/Issues
model Task {
  id String @id @default(cuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Task identification
  key         String // Task key (e.g., "ONEKOF-123")
  title       String
  description String?

  // Task properties
  type     TaskType     @default(TASK)
  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  // Assignment
  assigneeId String? @map("assignee_id")
  reporterId String  @map("reporter_id")

  // Hierarchy
  parentId String? @map("parent_id")

  // Time tracking
  estimate       Int?      @map("estimate") // In hours
  timeSpent      Int?      @map("time_spent") // In hours
  dueDate        DateTime? @map("due_date")
  startDate      DateTime? @map("start_date")
  completedAt    DateTime? @map("completed_at")

  // Labels and custom fields
  labels Json @default("[]")
  customFields Json @default("{}") @map("custom_fields")

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  comments    Comment[]
  attachments Attachment[]

  @@unique([projectId, key])
  @@map("tasks")
  @@schema("public")
}

// Task comments
model Comment {
  id String @id @default(cuid())

  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  content  String
  authorId String @map("author_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("comments")
  @@schema("public")
}

// Task attachments
model Attachment {
  id String @id @default(cuid())

  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  filename String
  url      String
  mimeType String @map("mime_type")
  size     Int // In bytes

  uploadedBy String   @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("attachments")
  @@schema("public")
}

// ============================================================================
// PROJECT MANAGEMENT ENUMS
// ============================================================================

enum ProjectTemplate {
  KANBAN
  SCRUM
  CUSTOM

  @@schema("public")
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER

  @@schema("public")
}

enum TaskType {
  TASK
  STORY
  BUG
  EPIC
  SUBTASK

  @@schema("public")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED

  @@schema("public")
}

enum TaskPriority {
  HIGHEST
  HIGH
  MEDIUM
  LOW
  LOWEST

  @@schema("public")
}

// ============================================================================
// TENANT SCHEMAS (created dynamically per organization)
// ============================================================================

// Note: The following models will be created in each organization's schema
// Example: onekof_org_abc123.workspaces, onekof_org_abc123.projects, etc.

// These are template models - actual tables created via migrations per tenant
