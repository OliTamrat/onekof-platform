// Onekof Platform Database Schema
// Multi-tenant architecture with schema-based isolation

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
  schemas    = ["public"]
}

// ============================================================================
// PUBLIC SCHEMA - Shared across all tenants
// ============================================================================

// Organizations (tenants)
model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  schemaName String   @unique @map("schema_name") // e.g., "onekof_org_abc123"

  // Subscription & billing
  plan             Plan         @default(FREE)
  status           OrgStatus    @default(TRIAL)
  billingEmail     String?      @map("billing_email")
  subscriptionId   String?      @map("subscription_id")
  trialEndsAt      DateTime?    @map("trial_ends_at")
  currentPeriodEnd DateTime?    @map("current_period_end")

  // Limits (based on plan)
  maxMembers   Int @default(10) @map("max_members")
  maxProjects  Int @default(10) @map("max_projects")
  maxStorage   Int @default(5)  @map("max_storage") // GB

  // Settings
  settings Json @default("{}")
  features Json @default("[]")

  // Ethiopian-specific
  preferredCalendar Calendar @default(GREGORIAN) @map("preferred_calendar")
  primaryLanguage   Language @default(EN) @map("primary_language")

  // Metadata
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  members     OrganizationMember[]
  invitations Invitation[]

  @@map("organizations")
  @@schema("public")
}

// Users (global, shared across organizations)
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")

  // Profile
  name        String?
  avatar      String?
  bio         String?
  phone       String?
  timezone    String   @default("Africa/Addis_Ababa")
  language    Language @default(EN)

  // Authentication
  password         String?   // Hashed with bcrypt
  resetToken       String?   // Password reset token
  resetTokenExpiry DateTime? @map("reset_token_expiry") // Reset token expiration

  // Preferences
  preferences Json @default("{}") // UI preferences, notifications, etc.

  // Metadata
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  accounts      Account[]
  sessions      Session[]
  organizations OrganizationMember[]

  @@map("users")
  @@schema("public")
}

// Organization membership
model OrganizationMember {
  id String @id @default(cuid())

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role OrgRole @default(MEMBER)

  // Metadata
  joinedAt  DateTime @default(now()) @map("joined_at")
  invitedBy String?  @map("invited_by")

  @@unique([organizationId, userId])
  @@map("organization_members")
  @@schema("public")
}

// Invitations
model Invitation {
  id String @id @default(cuid())

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email      String
  role       OrgRole
  token      String   @unique
  invitedBy  String   @map("invited_by")
  expiresAt  DateTime @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("invitations")
  @@schema("public")
}

// OAuth accounts (Google, Microsoft, etc.)
model Account {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String @map("provider_account_id")

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
  @@schema("public")
}

// Sessions (for NextAuth.js)
model Session {
  id String @id @default(cuid())

  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("public")
}

// Verification tokens (email verification, password reset)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
  @@schema("public")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE

  @@schema("public")
}

enum OrgStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED

  @@schema("public")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  GUEST

  @@schema("public")
}

enum Language {
  EN // English
  AM // Amharic (አማርኛ)
  OM // Afaan Oromo
  TI // Tigrinya (ትግርኛ)
  SO // Somali

  @@schema("public")
}

enum Calendar {
  GREGORIAN
  ETHIOPIAN

  @@schema("public")
}

// ============================================================================
// TENANT SCHEMAS (created dynamically per organization)
// ============================================================================

// Note: The following models will be created in each organization's schema
// Example: onekof_org_abc123.workspaces, onekof_org_abc123.projects, etc.

// These are template models - actual tables created via migrations per tenant
