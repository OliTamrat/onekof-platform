# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/onekof?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Redis (for caching and sessions)
REDIS_URL="redis://localhost:6379"

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=""

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@onekof.com"

# File Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Payments — Stripe (International)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Payments — Chapa (Ethiopia)
CHAPA_SECRET_KEY=""
CHAPA_WEBHOOK_SECRET=""

# Security
ADMIN_SECRET=""
ADMIN_USERS=""
CRON_SECRET=""
BLOB_ENCRYPTION_KEY=""

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Error Tracking
SENTRY_DSN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Onekof"

# Feature flags
NEXT_PUBLIC_ENABLE_AI_FEATURES="true"
NEXT_PUBLIC_ENABLE_ETHIOPIAN_CALENDAR="true"
