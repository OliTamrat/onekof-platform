# Sentry Configuration
# Get your DSN from https://sentry.io/settings/[your-org]/projects/[your-project]/keys/

# Public DSN (safe to expose in client-side code)
NEXT_PUBLIC_SENTRY_DSN=https://[key]@[org-id].ingest.sentry.io/[project-id]

# Server-side DSN (keep private)
SENTRY_DSN=https://[key]@[org-id].ingest.sentry.io/[project-id]

# Sentry Organization Slug (for source map uploads)
SENTRY_ORG=your-org-slug

# Sentry Project Name (for source map uploads)
SENTRY_PROJECT=onekof-platform

# Auth Token for uploading source maps (keep private!)
# Get from https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=your-auth-token-here

# App Version (for release tracking)
NEXT_PUBLIC_APP_VERSION=0.1.0
APP_VERSION=0.1.0

# Environment
NODE_ENV=production
