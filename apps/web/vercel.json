{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm exec prisma generate --schema=../../packages/database/prisma/schema.prisma && pnpm exec next build",
  "devCommand": "next dev",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "regions": ["fra1"],
  "crons": [
    { "path": "/api/cron/trial-expiry", "schedule": "0 6 * * *" },
    { "path": "/api/cron/subscription-renewal", "schedule": "0 7 * * *" },
    { "path": "/api/cron/usage-enforcement", "schedule": "0 8 * * *" }
  ]
}
