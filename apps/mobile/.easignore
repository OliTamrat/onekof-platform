# EAS Build ignore file — reduces upload size
# These files are not needed for the build process

# Dependencies — EAS installs these in the cloud
node_modules

# Docs and markdown
**/*.md
**/*.txt
**/*.pdf

# Test files
**/__tests__/**
**/*.test.*
**/*.spec.*

# Git
.git
.gitignore

# Editor config
.vscode
.idea
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Temporary files
*.tmp
*.temp

# Android build artifacts
android/.gradle
android/build
android/app/build

# iOS build artifacts
ios/build
ios/Pods
